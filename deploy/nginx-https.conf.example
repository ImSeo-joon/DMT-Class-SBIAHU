# Replace class.example.edu with the exact domain after ICP filing is approved
# and a TLS certificate has been issued for it.
server {
    listen 80;
    listen [::]:80;
    server_name class.example.edu;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name class.example.edu;

    ssl_certificate     /etc/letsencrypt/live/class.example.edu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/class.example.edu/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    # Must stay above the app's 25 MB upload cap (server.py MAX_RESOURCE_BYTES / app.py MAX_CONTENT_LENGTH).
    client_max_body_size 26m;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }
}
