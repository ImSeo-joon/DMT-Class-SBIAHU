# DMT CLASS 01 班级网站服务端配置
# 部署位置：/etc/dmt-class-site.env   权限：600（只允许 root 读取）
# systemd 通过 EnvironmentFile 自动加载，见 deploy/dmt-class-site.service.example
# 一键写入：sudo bash deploy/setup-mail.sh

# ---------- 站点 ----------
# 对外地址，必须带协议、结尾不要斜杠。用于来源校验、Cookie 的 Secure 标记，以及验证码邮件里的站点链接。
SITE_ORIGIN=https://dmtclass01.com

# ---------- 数据 ----------
DMT_DB_PATH=/var/lib/dmt-class-site/class_site.sqlite3
DMT_UPLOAD_DIR=/var/lib/dmt-class-site/uploads

# ---------- 限流 ----------
# 同一 IP 的限流时间窗（秒），默认 900（15 分钟）。校园网、宿舍 Wi-Fi 常常共用一个出口 IP，
# 同学扎堆注册时可以把这个窗口或代码里的次数调大。
RATE_WINDOW=900

# ---------- 发信：邮箱验证 ----------
# SMTP_PASSWORD 要填邮箱服务商生成的“授权码/专用密码”，不是邮箱登录密码。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=your-class-mailbox@qq.com
SMTP_PASSWORD=replace-with-authorization-code
SMTP_SENDER=your-class-mailbox@qq.com
SMTP_SENDER_NAME=DMT CLASS 01

# 常见服务商参数对照（阿里云、腾讯云的主机默认封禁 25 端口，务必用 465 或 587）：
#   腾讯 QQ 邮箱     smtp.qq.com          465  ssl       设置 → 账户 → 开启 POP3/SMTP 服务，生成授权码
#   网易 163 邮箱    smtp.163.com         465  ssl       开启 SMTP 服务后生成授权码
#   腾讯企业邮       smtp.exmail.qq.com   465  ssl       用邮箱密码或客户端专用密码，可用自己的域名
#   阿里云邮件推送   smtpdm.aliyun.com    465  ssl       先在控制台验证发信域名，SMTP_USER 填发信地址
#   Gmail            smtp.gmail.com       587  starttls  需要应用专用密码，内地网络访问不稳定
#   本地调试        127.0.0.1            2525  none      配合本地 SMTP 调试服务，仅用于测试

# SMTP_SECURITY 取值：ssl（465，推荐）、starttls（587）、none（仅本机调试）
# 发信域名如果用了自己的域名，记得在 DNS 里配 SPF 与 DKIM，否则容易被判为垃圾邮件。

# ---------- 生活专区：高德地图（美食推荐「学校周边的店」）----------
# 高德开放平台「Web 服务」Key（不是「Web 端 JS API」，两者不通用）。
# 未配置也能启动，只是 /api/nearby-food 会提示未配置，页面上那一栏查不出数据。
# 申请：https://lbs.amap.com/ → 控制台 → 应用管理 → 我的应用 → 添加 Key
AMAP_KEY=

# 可选：查询中心点（高德坐标系，经度,纬度）。不填则用龙河校区（肥西路 3 号）默认值。
# CAMPUS_LNG_LAT=117.2501336,31.8471875
