# DMT CLASS 01 —— Nginx 限流与防护（http 层）
#
# 安装位置：/etc/nginx/conf.d/00-dmt-ratelimit.conf
#
# 为什么单独一个文件：limit_req_zone / limit_conn_zone 只能写在 Nginx 主配置的
# http { } 块里，不能写在 server { } 里面。而 /etc/nginx/conf.d/*.conf 是被
# http { } 整体 include 进来的，所以放这里正好。
# 这个文件里不允许出现 server { }。
#
# 生效检查：sudo nginx -t && sudo systemctl reload nginx

# ---------- 分 IP 限流 ----------

# 通用速率：单 IP 30 次/秒。一个同学打开一次首页只会产生十几次请求，30 已经非常宽松。
limit_req_zone $binary_remote_addr zone=dmt_general:10m rate=30r/s;

# 写操作速率：单 IP 3 次/秒。用于登录、注册、留言、邀请码、测试邮件、AI 接口。
# 这些接口在 app.py 里本来就有 15 分钟窗口的次数限制（见 limited()），这里是第二道闸。
limit_req_zone $binary_remote_addr zone=dmt_write:10m rate=3r/s;

# 全站总速率兜底：所有来源合计 300 次/秒。
# 按 IP 限流挡不住"很多 IP 各刷几下"的分布式攻击，这一条是最后一道闸。
# 注意：它只是"防后端被彻底打满"的保底，不是 DDoS 防护。真正的大流量必须在 CDN /
# DDoS 高防 上游被吸掉，否则服务器还是会被阿里云关进黑洞（见 SECURITY-HARDENING.md）。
limit_req_zone $server_name zone=dmt_global:1m rate=300r/s;

# 单 IP 并发请求上限。Nginx 对 HTTP/2 的每个并发请求单独计数，所以这一条同时
# 限制了"一个 IP 同时挂多少个请求在服务器上"。
limit_conn_zone $binary_remote_addr zone=dmt_conn:10m;

# ---------- 被限流时的行为 ----------

# 默认返回 503（浏览器会以为服务器挂了）。改成 429 Too Many Requests，前端才好提示。
limit_req_status 429;
limit_conn_status 429;

# 被限流时记进 error.log，方便上线后判断有没有误伤正常同学。
limit_req_log_level warn;

# 不在响应头和错误页里暴露 Nginx 版本号。
server_tokens off;

# ---------- 挂了 CDN 之后必须做这一步：真实客户端 IP 还原 ----------
#
# 域名走阿里云 CDN 之后，Nginx 看到的 $remote_addr 会变成 CDN 回源节点的 IP，
# 于是"按 IP 限流"就退化成"按 CDN 节点限流"，全班同学被当成同一个人。
# 更严重的是 app.py 里按 IP 限流的留言、发帖、AI 接口（15 分钟 8 次）会被全班共享，
# 8 次之后所有人都用不了。
#
# 为什么不按"CDN 回源 IP 段"做白名单：阿里云 CDN 的回源节点 IP（L2）是动态分配的，
# 人工申请获取回源 IP 段已经停止，接口 DescribeL2VipsByDomain 要求日峰值带宽 ≥ 1Gbps。
# 官方「源站安全防护替代方案」给的做法是：CDN 回源时会透传 ali-cdn-real-ip 头，
# 源站直接从这个头取真实客户端 IP。
#
# 本班站点实际生效的三行（写在 /etc/nginx/conf.d/00-dmt-ratelimit.conf 末尾）：
#
# set_real_ip_from  0.0.0.0/0;
# set_real_ip_from  ::/0;
# real_ip_header    ali-cdn-real-ip;
#
# 为什么 set_real_ip_from 写 0.0.0.0/0：因为回源 IP 不固定，列不出白名单。
# 代价是：知道源站 IP 的人可以伪造 ali-cdn-real-ip 头绕过按 IP 的限流。
# 挡这一层靠的是站点配置里那句：
#   if ($http_ali_cdn_real_ip = "") { return 403; }
# 它让不带这个头的直接访问返回 403。头名是公开的，所以这是提高门槛，不是绝对防线。
#
# 改完必须实测一次（用手机流量打开网站，不要用家里的 Wi-Fi）：
#   sudo tail -5 /var/log/nginx/access.log
# 看第一列是不是手机的公网 IP（浏览器搜"IP"对照）。如果显示的是 CDN 节点的 IP，
# 说明没配对，这时候全班会一起被限流，请把这三行注释回去再排查。
